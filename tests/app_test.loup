@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_bad_expression_fails(): void {
    expectEq(run(["tests", "-bogus"]), EXIT_USAGE, "unknown predicate");
}

# A file as the starting point: walking directories asks `test -h` through a
# child process, which the parallel Stage0 test runner does not cope with.
func test_find_succeeds(): void {
    expectEq(run(["source/main.loup", "-name", "main.loup"]), EXIT_OK, "finds the entry point");
}

func test_missing_path_fails(): void {
    expectEq(run(["no/such/path"]), EXIT_FAILURE, "missing starting point");
}
