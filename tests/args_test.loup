@mode(host.dual)

# Unit tests for find's command-line parsing (source/cli/args.loup):
# starting points, what starts an expression, -H/-L/-P, and help, version
# and errors coming from the expression.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, starts_expression);
from commands.expr import (show);

func test_default_path(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.paths.len(), 1, "one path");
    expectEq(opts.paths[0], ".", "current directory");
    expectEq(opts.links, "P", "links not followed");
    expectEq(show(opts.query.root), "print", "default expression");
}

func test_paths_before_expression(): void {
    let opts = parse_args(["a", "b/c", "-name", "x"]).unwrap();
    expectEq(opts.paths.len(), 2, "two paths");
    expectEq(opts.paths[1], "b/c", "second path");
    expectEq(show(opts.query.root), "and(name(x),print)", "expression");
}

func test_what_starts_an_expression(): void {
    expect(starts_expression("-name"), "option");
    expect(starts_expression("("), "open paren");
    expect(starts_expression("!"), "bang");
    expect(!starts_expression("-"), "lone dash is a path");
    expect(!starts_expression(")"), "close paren is a path");
    expect(!starts_expression("dir"), "plain word");
}

func test_symlink_options(): void {
    expectEq(parse_args(["-L", "x"]).unwrap().links, "L", "-L");
    expectEq(parse_args(["-L", "-H", "x"]).unwrap().links, "H", "last wins");
    expectEq(parse_args(["-P"]).unwrap().paths[0], ".", "option then default path");
}

func test_help_and_version_inside_expression(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["dir", "--version"]).unwrap().version, "--version after a path");
}

func test_errors_come_from_the_expression(): void {
    expectEq(parse_args(["x", "-bogus"]).unwrap_err(), "unknown predicate `-bogus'", "bad predicate");
}
