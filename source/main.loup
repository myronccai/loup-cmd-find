@mode(host.dual)

# find: entry point of the Loup recreation of GNU find. Keep this file thin:
# all behaviour lives in cli.app.run so that tests can call it with an
# argument list.
#
# Runtime: host.dual. The entry point: main() gets the command line. The same
# source runs two ways: `make build` compiles it with the rest of source/
# into the native binary build/find, which `make e2e` then tests, and
# `make run` interprets it with Stage0 (`loup-bootstrap run
# source/main.loup`). Not with the self-hosted `loup run`: there listDir
# leaves out dot-files and exec() passes its argv through a shell inside
# double quotes, so -exec arguments holding `"`, `$` or backquotes break.

from cli.app import (run);

func main(): int {
    return run(runtime.args());
}
