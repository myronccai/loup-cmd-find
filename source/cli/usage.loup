@mode(host.dual)

# Help and version text for find: usage() is printed by -help/--help,
# version_line() by -version/--version.
#
# Runtime: host.dual. Compiled into the native binary build/find by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        i"Usage: {$ APP_NAME $} [-H] [-L] [-P] [PATH...] [EXPRESSION]",
        "",
        "Search the directory trees rooted at each PATH (default: the current",
        "directory) and evaluate EXPRESSION on every file and directory, from",
        "left to right. The default expression is -print.",
        "",
        "Operators, by decreasing precedence:",
        "  ( EXPR )              group",
        "  ! EXPR, -not EXPR     true if EXPR is false",
        "  EXPR1 -a EXPR2        and (also -and, or just EXPR1 EXPR2)",
        "  EXPR1 -o EXPR2        or (also -or)",
        "",
        "Global options (always true):",
        "  -maxdepth LEVELS      descend at most LEVELS below the starting points",
        "  -mindepth LEVELS      do not apply tests or actions above LEVELS",
        "",
        "Tests:",
        "  -name PATTERN         the last component of the path matches PATTERN",
        "  -iname PATTERN        like -name, ignoring case",
        "  -path PATTERN         the whole path matches PATTERN",
        "  -type f|d             a regular file or a directory (a list: f,d)",
        "  -empty                an empty regular file or directory",
        "  -true, -false         always true, always false",
        "",
        "Actions:",
        "  -print                print the path and a newline",
        "  -print0               print the path and a NUL byte",
        "  -prune                do not descend into this directory (true)",
        "  -exec COMMAND ;       run COMMAND, {} replaced by the path; true if it",
        "                        exits with status 0",
        "  -exec COMMAND {} +    run COMMAND once with many paths at the end",
        "",
        "Patterns use shell wildcards: * ? [...] [!...]; quote them.",
        "",
        "  -help, --help         display this help and exit",
        "  -version, --version   output version information and exit",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
