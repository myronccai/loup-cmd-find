@mode(host.dual)

# The command-line driver of find: parses argv into starting points and an
# expression, answers -help and -version, runs the search and returns its
# exit status.
#
# Runtime: host.dual. Compiled into the native binary build/find by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/app_test.loup calls run() directly under Stage0 (`make test`).

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (Options, parse_args);
from cli.usage import (usage, version_line);
from commands.find import (run_find);

# Parses argv, runs find and returns the exit status. GNU find reports a bad
# command line with one message and status 1, without a usage hint.
pub func run(argv: list[string]): int {
    var opts_result = parse_args(argv);
    if (opts_result.is_err()) {
        printErr(i"{$ APP_NAME $}: {$ opts_result.unwrap_err() $}");
        return EXIT_USAGE;
    }
    let opts = opts_result.unwrap();

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_find(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
