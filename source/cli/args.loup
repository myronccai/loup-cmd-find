@mode(host.dual)

# Command-line parsing for find:
#
#   find [-H] [-L] [-P] [PATH...] [EXPRESSION]
#
# The leading arguments that do not look like the start of an expression are
# the starting points (default: `.`). The first argument that starts with `-`
# (other than a lone `-`), or is `(` or `!`, starts the expression, which
# commands.expr parses into a tree. `--help` and `--version` are read as
# part of the expression, as GNU find does.

from commands.expr import (Query, parse_expression);

pub struct Options {
    pub help: bool;
    pub version: bool;
    # How symbolic links are treated: "P" (default), "H" or "L".
    pub links: string;
    pub paths: list[string];
    pub query: Query;
}

# Whether `arg` starts the expression rather than naming a starting point.
pub func starts_expression(arg: string): bool {
    if (arg == "(" or arg == "!") {
        return true;
    }
    return arg.len() > 1 and arg.startsWith("-");
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    var i = 0;
    # -P (the default) never follows symbolic links to directories, -H
    # follows them for the starting points only, -L always. The last wins.
    var links = "P";
    while (i < argv.len() and (argv[i] == "-H" or argv[i] == "-L" or argv[i] == "-P")) {
        links = argv[i].slice(1);
        i += 1;
    }
    var paths: list[string] = [];
    while (i < argv.len() and !starts_expression(argv[i])) {
        paths.push(argv[i]);
        i += 1;
    }
    if (paths.len() == 0) {
        paths.push(".");
    }
    let query = parse_expression(argv.slice(i))?;
    return Ok(Options(help = query.help, version = query.version, links = links,
        paths = paths, query = query));
}
