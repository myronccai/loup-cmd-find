@mode(host.dual)

# Application identity and exit statuses of find. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants compiled into the native binary build/find
# by `make build`; `make run` and the unit tests (`make test`), both
# Stage0, use the same definitions.

pub const APP_NAME: string = "find";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Search a directory tree with an expression (a Loup recreation of GNU find).";

# Exit statuses returned by main(). GNU find uses 1 both for errors met while
# walking and for a bad command line.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
